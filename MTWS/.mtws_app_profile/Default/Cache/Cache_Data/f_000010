  </div>
  <div class="ia-list" id="ia-list"></div>
  <div class="ia-pagination" id="ia-pagination"></div>
</section>

<!-- 设置弹窗 -->
<div id="settings-modal" class="modal">
  <div class="modal-content settings-modal-content">
    <div class="settings-modal-header">
      <h3>系统设置</h3>
      <div style="display:flex;gap:8px;align-items:center;">
        <span id="settings-admin-unlock" style="display:none;align-items:center;gap:4px;">
          <input type="password" id="settings-admin-password" placeholder="超级用户密码" autocomplete="current-password" style="width:140px;">
