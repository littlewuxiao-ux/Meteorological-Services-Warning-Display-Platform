        <button class="search-clear-btn" id="search-clear-btn" title="清除输入" aria-label="清除">&#x2716;</button>
      </div>
      <button class="action-btn" id="search-btn">搜索</button>
      <button class="action-btn" id="refresh-btn" style="margin-left: 8px;">刷新</button>
      <button class="action-btn" id="settings-btn" style="margin-left: 8px;">设置</button>
    </div>
  </div>
</section>

<!-- 时间轴标题行 -->
<div class="title-row main-title-row">
  <!-- 机场标题 -->
  <div class="title-airport">
    <span class="title-text">机场</span>
  </div>

  <!-- 实况信息标题 -->
  <div class="title-weather">
    <span class="title-text">实况信息</span>
  </div>

  <!-- 时间轴 -->
  <div class="title-timeline">
    <!-- 北京时时间轴 -->
    <div class="timeline-row beijing-time">
      <div id="beijing-timeline" class="timeline-container"></div>
    </div>
    <!-- 世界时时间轴 -->
    <div class="timeline-row utc-time">
      <div id="utc-timeline" class="timeline-container"></div>
    </div>
  </div>
</div>
</div>

<!-- 5.3 内容区域 -->
<section class="content-section">
  <!-- 正文区域 -->
  <div class="content-main" id="content-main">
    <!-- 机场信息将通过JavaScript动态加载 -->
