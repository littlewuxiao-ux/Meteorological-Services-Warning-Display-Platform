        <span class="margin-h-label" data-value="1">1</span>
        <span class="margin-h-label" data-value="2">2</span>
        <span class="margin-h-label" data-value="3">3</span>
        <span class="margin-h-label" data-value="4">4</span>
        <div class="margin-h-thumb" id="margin-v-thumb"></div>
      </div>
    </div>
  </div>

  <!-- 分隔线 -->
  <div class="separator"></div>

  <!-- 右边区域 -->
  <div class="function-right">
    <!-- 第1行：承运人、实况弹窗、排序、温度辅助 -->
