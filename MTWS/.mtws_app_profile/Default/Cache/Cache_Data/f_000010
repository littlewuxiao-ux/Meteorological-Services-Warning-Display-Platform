          data-field="operation">运行类</button>
        <button class="filter-btn popup-toggle-btn" id="parking-toggle" data-field="parking">停场类</button>
        <button class="snooze-restore-btn snooze-restore-inactive" id="snooze-restore-btn" title="没有可恢复的实况弹窗">
          <svg viewBox="0 0 1024 1024" xmlns="http://www.w3.org/2000/svg" width="20" height="20">
            <path
              d="M833.024 104.448H409.088c-43.008 0-77.824 34.816-77.824 77.824v30.208H188.928c-38.4 0-70.144 31.232-70.144 70.144v559.104c0 38.4 31.232 70.144 70.144 70.144h423.936c38.4 0 70.144-31.232 70.144-70.144V819.2h150.016c43.008 0 77.824-34.816 77.824-77.824V181.76c0-42.496-35.328-77.312-77.824-77.312z m-150.016 552.448v-43.52c63.488-38.912 110.08-101.888 127.488-177.664l15.872-66.56c4.096-16.384-1.536-33.792-14.848-44.032-18.432-14.336-45.056-11.776-59.392 6.656l-57.856 68.096c-3.584 4.608-7.68 8.704-11.776 12.8V281.6c0-38.4-31.232-70.144-70.144-70.144H386.56v-30.208c0-12.288 10.24-22.528 22.528-22.528h423.936c12.288 0 22.528 10.24 22.528 22.528v559.104c0 12.288-10.24 22.528-22.528 22.528h-150.016v-105.984z m-124.928-38.4l-16.384 1.536v103.936c0 2.56-1.024 4.096-2.048 4.608s-2.56 2.048-4.608 2.048c-1.536 0-3.072-0.512-4.608-1.536l-178.688-159.232c-2.56-2.56-3.072-6.656-0.512-9.728l0.512-0.512 178.688-152.576c1.536-1.536 3.072-1.536 4.608-1.536h0.512c1.024 0 3.072 0.512 4.608 2.56 1.024 1.024 1.536 2.56 1.536 4.096v98.816l19.968-2.048c62.464-6.656 119.296-36.864 160.256-84.992l57.856-68.096 0.512-0.512c2.048-3.072 6.656-3.584 9.216-1.024 2.048 1.536 3.072 4.608 2.048 7.168l-15.872 67.072c-24.064 103.424-111.104 179.712-217.6 189.952z"
              fill="currentColor" />
          </svg>
        </button>
      </div>

      <div class="select-group" title="机场排序方式切换" style="margin-left: 20px;">
        <select id="airport-sort-select" class="filter-select airport-sort-filter-select">
          <option value="alert-asc">告警正序</option>
          <option value="region-asc">区域正序</option>
          <option value="alert-desc">告警逆序</option>
          <option value="region-desc">区域逆序</option>
        </select>
      </div>

      <button class="action-btn" id="nwp-btn" style="margin-left: 20px;">温度辅助</button>
      <button class="action-btn margin-left" id="monitor-btn" style="display: none;">异常监控</button>
    </div>

    <!-- 第2行：时区切换、视图切换、时间范围、搜索、刷新、设置 -->
    <div class="filter-row">
      <label class="timezone-toggle-label" title="北京时/世界时切换开关">
        <input type="checkbox" id="timezone-toggle-input" />
        <div class="timezone-toggle-track">
          <span class="timezone-track-label left">CST</span>
          <span class="timezone-track-label right">UTC</span>
          <div class="timezone-toggle-thumb"></div>
        </div>
      </label>

      <label class="timezone-toggle-label" title="时间范围" style="margin-left: 8px;">
        <input type="checkbox" id="time-range-toggle-input" />
        <div class="timezone-toggle-track time-range-toggle-track">
          <span class="timezone-track-label left">36h</span>
          <span class="timezone-track-label right">48h</span>
          <div class="timezone-toggle-thumb"></div>
        </div>
