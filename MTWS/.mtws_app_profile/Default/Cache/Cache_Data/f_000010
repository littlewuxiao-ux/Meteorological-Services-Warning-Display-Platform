      <label class="trend-hours" id="map-hours-label" title="过去固定 2 小时，此数字只作用于未来">未来
        <input type="number" id="map-future-hours" min="0" max="9" step="1" value="2">
        小时
      </label>
    </div>
    </div>
    <div class="map-wx-module" id="map-wx-layer-panel">
      <span class="map-wx-module-title">图层控制</span>
      <label class="trend-switch map-wx-check">
        <input type="checkbox" data-wx="radar">
        <span class="map-wx-box"></span>
        <span>雷达回波</span>
      </label>
      <span class="map-wx-time" data-wx-time="radar"></span>
      <div class="map-wx-sat" id="map-wx-sat-block">
        <button type="button" class="trend-switch map-wx-sat-btn" data-wx="sat-toggle">
          <span class="map-wx-box"></span>
          <span class="map-wx-sat-label">卫星云图</span>
        </button>
        <div class="map-wx-sat-menu" id="map-wx-sat-sub" hidden>
          <button type="button" data-wx="sat_ir">红外</button>
          <button type="button" data-wx="sat_wv">水汽</button>
          <button type="button" data-wx="sat_vis">可见光</button>
        </div>
      </div>
      <span class="map-wx-time" data-wx-time="sat"></span>
      <span id="map-wx-layer-tip" class="map-wx-layer-tip" style="display:none;"></span>
    </div>
  </div>
  <div class="map-chart-wrap">
  <!-- 中国/世界切换开关：浮于地图顶部中央 -->
  <div class="map-view-overlay-wrap">
    <label class="map-view-toggle-label" title="中国/世界视图切换">
      <input type="checkbox" id="map-view-toggle-input" />
      <div class="map-view-toggle-track">
        <span class="map-view-track-label left">China</span>
        <span class="map-view-track-label right">World</span>
        <div class="map-view-toggle-thumb"></div>
      </div>
    </label>
  </div>
    <div id="map-world" class="map-chart-pane"></div>
    <div id="map-airport-tip" class="map-airport-tip" style="display:none;"></div>
  <!-- 强对流雷达预警悬浮列表（可拖动） -->
  <div id="radar-alert-float" class="radar-alert-float" style="display:none;">
    <div class="radar-alert-float-header" id="radar-alert-float-drag">
      <span>强对流预警</span>
      <div class="radar-alert-mode" id="radar-alert-mode">
        <span class="radar-alert-mode-alarm">告警项</span>
        <button type="button" data-mode="observe" title="打开后在告警项下方追加观察项">观察项</button>
      </div>
    </div>
    <div id="radar-alert-rate-tip" class="radar-alert-rate-tip"></div>
    <div class="radar-alert-float-body" id="radar-alert-float-body"></div>
    <div class="radar-alert-float-footer">
      <button type="button" id="radar-alert-run-btn" class="radar-alert-footer-btn">刷新预警</button>
    </div>
  </div>
  </div>
</div>

<!-- 中文（明语）模式面板：替换机场行 / 实况信息标题 / 时间轴及以下内容，功能区不变 -->
<section id="plain-panel" style="display:none;">
  <div class="plain-loading">正在加载数据...</div>
</section>

<section id="trend-panel" style="display:none;">
  <div class="trend-toolbar">
    <div class="trend-title">实况趋势告警</div>
    <div class="trend-toolbar-main">
      <label class="trend-switch map-wx-check"><input type="radio" name="trend-scope" value="has_flight" checked><span class="map-wx-box"></span><span>有航班机场</span></label>
