              <span class="info-value" id="sunrise-time">--:--</span>
            </div>
            <div class="info-item">
              <span class="info-label">日落:</span>
              <span class="info-value" id="sunset-time">--:--</span>
            </div>
            <div class="info-item">
              <span class="info-label">跑道:</span>
              <span class="info-value" id="runway-info">--</span><span class="airport-detail-info-hint"
                title="日出日落时间采用外网公开数据获取的机场坐标经过计算得到，跑道号为公开数据直接获取，以上数据仅做参考，如需详细资料请参考官方数据。" aria-label="说明">&#x24D8;</span>
            </div>
          </div>
          <div class="airport-info-divider"></div>
          <div class="airport-info-contacts">
            <div class="contact-item">
              <span class="contact-label">区号:</span>
              <span class="contact-value" id="area-code">N/A</span>
            </div>
            <div class="contact-item">
              <span class="contact-label">预报:</span>
              <span class="contact-value" id="forecast-phone">N/A</span>
            </div>
            <div class="contact-item">
              <span class="contact-label">观测:</span>
              <span class="contact-value" id="observation-phone">N/A</span>
            </div>
            <div class="contact-item">
              <span class="contact-label">其他:</span>
              <span class="contact-value" id="other-phone">N/A</span>
            </div>
          </div>
        </div>
      </div>

      <!-- 第2行：机场数据展示区域（复用主页布局） -->
      <div class="airport-data-section">
        <div id="airport-detail-plain-metar" class="plain-detail-metar-wrap" hidden></div>
        <!-- 标题行区域 -->
        <div class="title-row airport-detail-title-row">
          <!-- 实况信息标题 -->
          <div class="title-weather">
            <span class="title-text">实况信息</span>
          </div>

          <!-- 时间轴 -->
          <div class="title-timeline">
            <!-- 北京时时间轴 -->
            <div class="timeline-row beijing-time">
              <div id="airport-detail-beijing-timeline" class="timeline-container"></div>
            </div>
            <!-- 世界时时间轴 -->
            <div class="timeline-row utc-time">
              <div id="airport-detail-utc-timeline" class="timeline-container"></div>
            </div>
          </div>
        </div>

        <!-- 机场数据内容 -->
        <div class="airport-detail-main" id="airport-detail-main">
          <!-- 机场信息将通过JavaScript动态加载 -->
        </div>
      </div>

      <!-- 实况/预报报文 -->
      <div class="airport-reports-section">
        <h3>实况/预报报文</h3>
        <div class="reports-content">
          <div class="report-group report-group-metar">
            <div class="report-group-body" id="airport-metar-reports"></div>
          </div>
          <div class="report-group report-group-taf">
            <div class="report-group-body" id="airport-taf-reports"></div>
          </div>
        </div>
      </div>

      <!-- 图表区域：默认折叠，点击开关展开后才加载图表 -->
      <div class="airport-chart-section collapsed" id="airport-chart-section">
        <div class="chart-toggle-switch" onclick="toggleAirportChartSection()">
          <span class="chart-toggle-switch-text" id="chart-toggle-switch-text">&gt;&gt; 点击展开实况趋势图表 &lt;&lt;</span>
        </div>
        <div class="airport-chart-body">
          <div class="chart-time-selector-row">
            <div class="chart-time-selector">
              <div class="chart-time-radios">
                <label class="chart-time-radio"><input type="radio" name="chart-time-detail" value="3"
                    checked><span>3</span></label>
                <label class="chart-time-radio"><input type="radio" name="chart-time-detail"
                    value="6"><span>6</span></label>
                <label class="chart-time-radio"><input type="radio" name="chart-time-detail"
                    value="12"><span>12</span></label>
                <label class="chart-time-radio"><input type="radio" name="chart-time-detail"
                    value="24"><span>24</span></label>
                <label class="chart-time-radio"><input type="radio" name="chart-time-detail"
                    value="48"><span>48</span></label>
                <label class="chart-time-radio"><input type="radio" name="chart-time-detail"
                    value="72"><span>72</span></label>
              </div>
              <div class="chart-time-custom">
                <input type="number" class="chart-time-input" id="chart-time-input-detail" placeholder="2-72小时" min="2"
                  max="72">
                <button class="chart-time-btn" onclick="applyCustomChartTimeForDetail()">确定</button>
              </div>
            </div>
          </div>
          <div class="airport-chart-container">
            <div class="airport-chart" id="airport-detail-chart"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- 机场搜索多结果弹窗（2个及以上四字代码时使用） -->
<div id="airport-search-modal" class="modal">
  <div class="modal-content airport-search-modal-content">
    <span class="modal-close">&times;</span>
    <div id="airport-search-container" class="airport-search-container">
      <!-- 机场条目列表（动态生成，每个机场各自含时间轴） -->
      <div id="airport-search-list" class="airport-search-list">
      </div>
    </div>
  </div>
</div>

