  <title>航空气象报文综合监控告警系统</title>
  
  <link rel="icon" type="image/svg+xml" href="/static/svg/mtws-favicon.svg" id="mtws-favicon">
  <link rel="stylesheet" href="/static/css/main.css">
  
<link rel="stylesheet" href="/static/css/views.css">
<link rel="stylesheet" href="/static/css/trend.css">

</head>

<body>
  <script>
    (function () {
      var raw = '{\u0022R\u0022: {\u0022hex\u0022: \u0022#e74c3c\u0022, \u0022rgb\u0022: \u0022231, 76, 60\u0022}, \u0022Y\u0022: {\u0022hex\u0022: \u0022#f39c12\u0022, \u0022rgb\u0022: \u0022243, 156, 18\u0022}, \u0022G\u0022: {\u0022hex\u0022: \u0022#27ae60\u0022, \u0022rgb\u0022: \u002239, 174, 96\u0022}, \u0022N\u0022: {\u0022hex\u0022: \u0022#95a5a6\u0022, \u0022rgb\u0022: \u0022149, 165, 166\u0022}}';
      var colors = null;
      try { colors = raw ? JSON.parse(raw) : null; } catch (e) { colors = null; }
      window.MTWS_ALERT_COLORS = colors;
      if (!colors) return;
      var root = document.documentElement;
      ['R', 'Y', 'G', 'N'].forEach(function (k) {
        var c = colors[k];
        if (!c) return;
        var key = k.toLowerCase();
        if (c.hex) root.style.setProperty('--alert-' + key, c.hex);
        if (c.rgb) root.style.setProperty('--alert-' + key + '-rgb', c.rgb);
      });
    })();
  </script>
  
<!-- 服务器断连提示横幅（轮询失败时显示，恢复后自动隐藏） -->
<div id="server-offline-banner">⚠ 服务器连接已断开，正在等待重连...</div>

<!-- 顶栏 + 功能区 + 时间轴整行：作为一块 sticky（top:0）。
     三条各自 sticky 时，title-row 的 top:180px 无法跟随功能区真实高度，会随列表滚走。 -->
<div class="page-chrome">
<!-- 5.1 头部区域 -->
<header class="header-section">
